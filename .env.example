# Copy to .env to override defaults used by docker-compose.yml
POSTGRES_DB=cloudrescue
POSTGRES_USER=cloudrescue
POSTGRES_PASSWORD=change-me

# Fault injection must be FALSE in any non-dev/test deployment.
FAULT_INJECTION_ENABLED=true

# FIXED_RETRY | EXPONENTIAL_BACKOFF | COST_AWARE
DEFAULT_POLICY=COST_AWARE

# Seed for simulator randomness (probe jitter, restart failures)
SIMULATION_SEED=42
